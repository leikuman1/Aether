# 复制为 .env 并按需填写；不填 AETHER_LLM_API_KEY 则以"无外部调用"模式运行（测试/演练）
AETHER_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AETHER_LLM_MODEL=glm-4.6
AETHER_LLM_API_KEY=
AETHER_EMBEDDING_MODEL=embedding-3
# fake 为离线默认；生产切 openai 并设置密钥/模型输出维度。
AETHER_EMBEDDING_PROVIDER=fake
AETHER_EMBEDDING_DIM=2048
AETHER_FAKE_EMBEDDING_DIM=256
AETHER_EMBEDDING_TIMEOUT=30
AETHER_EMBEDDING_BATCH_SIZE=64
AETHER_EMBEDDING_MAX_RETRIES=3
AETHER_EMBEDDING_RETRY_DELAY=0.5
AETHER_DENSE_BACKEND=sqlite-vec
AETHER_RETRIEVAL_RRF_K=60
AETHER_RETRIEVAL_ROUTE_DEPTH=50
# 本黄金集 FakeEmbedder 校准值；生产需独立验证，不代表混合检索增益。
AETHER_RETRIEVAL_SPARSE_WEIGHT=16
AETHER_RETRIEVAL_DENSE_WEIGHT=1
# 纠错 Agent。min_support_terms 是离线证据门，不是语义模型的置信度。
AETHER_AGENT_REWRITE_BUDGET=2
AETHER_AGENT_RETRIEVAL_K=5
AETHER_AGENT_MIN_SUPPORT_TERMS=4
AETHER_AGENT_MIN_QUOTE_CHARS=12
AETHER_LLM_TIMEOUT=30
AETHER_LLM_MAX_RETRIES=2
AETHER_LLM_TEMPERATURE=0
# 服务默认单 worker。先摄取再聊天；允许摄取路径默认限制在 data_dir/corpus。
# uv run aether-api 会强制打开 JSON 日志。自行拉 uvicorn 时设为 1。
# AETHER_JSON_LOGS=1
AETHER_API_REQUEST_TIMEOUT=60
AETHER_API_MAX_CONCURRENCY=32
AETHER_API_TOKEN_CHUNK_CHARS=16
# 可选：改为语料目录绝对路径；不配置则默认 data_dir/corpus。
# AETHER_API_INGEST_ROOT=/absolute/path/to/corpus
# 每百万输入/输出 token 的 USD 单价；按实际 provider 套餐填写，不内置模型价目表。
AETHER_LLM_INPUT_COST_PER_MILLION=0
AETHER_LLM_OUTPUT_COST_PER_MILLION=0
AETHER_DATA_DIR=./data
